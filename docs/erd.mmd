    Справочник_Агенты |o--o{ Документ_Договоры : ""
    Справочник_Клиенты ||--o{ Документ_Договоры : ""
    Справочник_Валюты ||--o{ Документ_Договоры : ""
    Документ_Договоры ||--|{ ТЧ_УчастникиПоездки : "ТЧ"
    Документ_Договоры ||--|{ ТЧ_МаршрутПоездки : "ТЧ"
    Справочник_Отели ||--o{ ТЧ_МаршрутПоездки : ""
    Справочник_ВидыНомеров ||--o{ ТЧ_МаршрутПоездки : ""

    Документ_Договоры ||--o| Документ_Оплаты : "100% оплата"
    Справочник_Организации ||--o{ Документ_Оплаты : ""
    Документ_Договоры ||--o| Документ_Ваучеры : "выдача документов"
    Документ_Ваучеры ||--|{ ТЧ_Размещение : "ТЧ"

    Справочник_Валюты ||--o{ РегистрСведений_КурсыВалют : ""
    Справочник_Сотрудники ||--o{ РегистрСведений_РегистрАдресации : ""
    Справочник_РолиСотрудников ||--o{ РегистрСведений_РегистрАдресации : ""
    Документ_Договоры ||--o{ РегистрНакопления_РасчетыПоДоговорам : "движения"
    Документ_Оплаты ||--o{ РегистрНакопления_РасчетыПоДоговорам : "движения"
    Документ_Оплаты ||--o{ РегистрНакопления_Продажи : "движения"

    Документ_ПредварительноеСоглашение ||--|| БизнесПроцесс_ОформлениеПоездки : "старт при записи"
    БизнесПроцесс_ОформлениеПоездки ||--|{ Задача_ЗадачаСотрудника : "этапы"
    Справочник_РолиСотрудников ||--o{ Задача_ЗадачаСотрудника : "кому"
    Справочник_Сотрудники |o--o{ Задача_ЗадачаСотрудника : "кто выполнил"
