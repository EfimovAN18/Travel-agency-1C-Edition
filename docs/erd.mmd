erDiagram
    %% ===== Справочники =====
    Справочник_Организации {
        Строка_9 Код PK
        Строка_50 Наименование
    }
    Справочник_Сотрудники {
        Строка_9 Код PK
        Строка_50 Наименование "Фамилия И.О. / имя пользователя"
        Строка_100 ФИО
        Дата ДатаРождения
        ХранилищеЗначения Фото
    }
    Справочник_Агенты {
        Строка_9 Код PK
        Строка_50 Наименование
        Строка_100 ФИО
        СпрСсылка Организация FK
    }
    Справочник_Клиенты {
        Строка_9 Код PK
        Строка_50 Наименование
        ПеречСсылка СтатусКлиента FK
        Строка_100 ФИО
        ПеречСсылка Пол FK
        Дата ДатаРождения
        Строка_100 МестоРождения
        Строка_4 ПаспортСерия
        Строка_10 ПаспортНомер
        Дата ПаспортДатаВыдачи
        Дата ПаспортДатаОкончания
        Строка_100 ПаспортКемВыдан
    }
    Справочник_Страны {
        Строка_9 Код PK
        Строка_50 Наименование
    }
    Справочник_Города {
        Строка_9 Код PK
        СпрСсылка Владелец FK "Страна"
        Строка_50 Наименование
    }
    Справочник_Отели {
        Строка_9 Код PK
        СпрСсылка Владелец FK "Город"
        Строка_100 Наименование
        Строка_150 Адрес
        ПеречСсылка Тип FK
    }
    Справочник_ВидыНомеров {
        Строка_9 Код PK
        Строка_50 Наименование
        Число_2_0 Вместимость
    }
    Справочник_Валюты {
        Число_3_0 Код PK "цифровой код ЦБ"
        Строка_100 Наименование
        Строка_3 СимвольныйКод
        Число_10_0 Кратность
    }
    Справочник_РолиСотрудников {
        Строка_9 Код PK
        Строка_50 Наименование "Менеджер/Бухгалтер/Администратор"
    }

    %% ===== Перечисления =====
    Перечисление_Пол {
        Значение Мужской
        Значение Женский
    }
    Перечисление_СтатусКлиента {
        Значение Обычный
        Значение Привилегированный
        Значение VIP
    }
    Перечисление_ТипОтеля {
        Значение ОднаЗвезда
        Значение ДвеЗвезды
        Значение ТриЗвезды
        Значение ЧетыреЗвезды
        Значение ПятьЗвезд
        Значение Апартаменты
    }

    %% ===== Документы =====
    Документ_ПредварительноеСоглашение {
        Строка_9 Номер PK
        ДатаВремя Дата
        СпрСсылка Организация FK
        СпрСсылка Агент FK "необязательный"
        СпрСсылка СтранаПосещения FK
        СпрСсылка Клиент FK
        Число_2_0 КоличествоУчастников
        Дата НачалоПоездки
        Дата ОкончаниеПоездки
    }
    ТЧ_ГородаПосещения {
        СпрСсылка Город FK
    }
    Документ_Договоры {
        Строка_9 Номер PK
        ДатаВремя Дата
        ДокСсылка Соглашение FK
        СпрСсылка Организация FK
        СпрСсылка Агент FK "необязательный"
        СпрСсылка Клиент FK
        Дата НачалоПоездки
        Дата ОкончаниеПоездки
        СпрСсылка СтранаПосещения FK
        СпрСсылка Валюта FK
        Число_15_2 Сумма
    }
    ТЧ_УчастникиПоездки {
        Строка_100 ФИО
    }
    ТЧ_МаршрутПоездки {
        СпрСсылка Город FK
        СпрСсылка Отель FK
        СпрСсылка ВидНомера FK
        Дата ДатаНачала
        Дата ДатаОкончания
    }
    Документ_Оплаты {
        Строка_9 Номер PK
        ДатаВремя Дата
        СпрСсылка Организация FK
        ДокСсылка Договор FK
        Число_15_2 СуммаВРублях
    }
    Документ_Ваучеры {
        Строка_9 Номер PK
        ДатаВремя Дата
        ДокСсылка Договор FK
        СпрСсылка Организация FK
        СпрСсылка Клиент FK
        СпрСсылка СтранаПосещения FK
        Дата НачалоПоездки
        Дата ОкончаниеПоездки
    }
    ТЧ_Размещение {
        СпрСсылка Город FK
        СпрСсылка Отель FK
        СпрСсылка ВидНомера FK
        Дата ДатаНачала
        Дата ДатаОкончания
    }

    %% ===== Регистры =====
    РегистрСведений_КурсыВалют {
        Дата Период PK "периодичность: день"
        СпрСсылка Валюта PK
        Число_10_4 Курс
        Число_10_0 Кратность
    }
    РегистрСведений_РегистрАдресации {
        СпрСсылка Сотрудник PK
        СпрСсылка Роль PK
    }
    РегистрНакопления_РасчетыПоДоговорам {
        ДокСсылка Регистратор "Договор+ / Оплата-"
        СпрСсылка Организация
        ДокСсылка Договор
        Число_15_2 Сумма "остатки, в валюте договора"
    }
    РегистрНакопления_Продажи {
        ДокСсылка Регистратор "Оплата"
        СпрСсылка Организация
        СпрСсылка Агент
        СпрСсылка Страна
        Число_15_2 СуммаРуб "обороты"
        Число_10_0 КоличествоДоговоров
    }

    %% ===== Бизнес-процесс =====
    БизнесПроцесс_ОформлениеПоездки {
        Строка_9 Номер PK
        ДатаВремя Дата
        ДокСсылка Соглашение FK
        ДокСсылка Договор FK
        ДокСсылка Оплата FK
        ДокСсылка Ваучер FK
    }
    Задача_ЗадачаСотрудника {
        Строка_9 Номер PK
        Строка_150 Наименование
        Булево Выполнена
        БПСсылка БизнесПроцесс FK
        ТочкаМаршрута ТочкаМаршрута
        СпрСсылка Сотрудник "адресация"
        СпрСсылка Роль "адресация"
    }

    %% ===== Связи =====
    Справочник_Организации ||--o{ Справочник_Агенты : "работает в (только одной)"
    Справочник_Страны ||--o{ Справочник_Города : "владелец"
    Справочник_Города ||--o{ Справочник_Отели : "владелец"
    Перечисление_ТипОтеля ||--o{ Справочник_Отели : "тип"
    Перечисление_Пол ||--o{ Справочник_Клиенты : "пол"
    Перечисление_СтатусКлиента ||--o{ Справочник_Клиенты : "статус"

    Справочник_Организации ||--o{ Документ_ПредварительноеСоглашение : ""
