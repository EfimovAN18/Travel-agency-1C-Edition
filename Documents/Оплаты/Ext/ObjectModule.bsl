#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	// Обязательность всех полей задана в метаданных: ПроверкаЗаполнения = "Выдавать ошибку".
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат;
	КонецЕсли;

	// В оплату можно выбрать только договор указанной организации.
	Если ЗначениеЗаполнено(Организация) И Договор.Организация <> Организация Тогда
		СообщитьОбОшибке("Договор оформлен в другой организации.", "Договор", Отказ);
	КонецЕсли;

	// Оплата должна быть произведена полностью, частичная оплата запрещена.
	Расчет = Документы.Оплаты.СуммаКОплатеВРублях(Договор);
	Если Не ПустаяСтрока(Расчет.ТекстОшибки) Тогда
		СообщитьОбОшибке(Расчет.ТекстОшибки, "СуммаВРублях", Отказ);
	ИначеЕсли СуммаВРублях <> Расчет.Сумма Тогда
		СообщитьОбОшибке(СтрШаблон(
			"Частичная оплата запрещена. Сумма к оплате по договору: %1 руб.",
			Формат(Расчет.Сумма, "ЧДЦ=2; ЧН=0,00")), "СуммаВРублях", Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СообщитьОбОшибке(ТекстСообщения, ИмяПоля, Отказ)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Поле = ИмяПоля;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();

	Отказ = Истина;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение "Недопустимый вызов объекта на клиенте.";
#КонецЕсли
