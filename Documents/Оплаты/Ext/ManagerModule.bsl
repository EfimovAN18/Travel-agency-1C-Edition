#Область ПрограммныйИнтерфейс

// Рассчитывает сумму полной оплаты договора в рублях.
//
// Параметры:
//  Договор - ДокументСсылка.Договоры
//
// Возвращаемое значение:
//  Структура:
//   * Сумма - Число - сумма к оплате в рублях (0, если рассчитать не удалось),
//   * ТекстОшибки - Строка - причина, по которой сумму рассчитать не удалось.
//
Функция СуммаКОплатеВРублях(Договор) Экспорт

	Результат = Новый Структура("Сумма, ТекстОшибки", 0, "");

	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Договоры.Сумма КАК Сумма,
	|	Договоры.Валюта КАК Валюта,
	|	ЕСТЬNULL(Договоры.Валюта.Код, 0) КАК КодВалюты,
	|	ЕСТЬNULL(Договоры.Валюта.Номинал, 1) КАК Кратность
	|ИЗ
	|	Документ.Договоры КАК Договоры
	|ГДЕ
	|	Договоры.Ссылка = &Договор";
	Запрос.УстановитьПараметр("Договор", Договор);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	// Курс ЦБ для рубля (код 643) не публикуется.
	Если Выборка.КодВалюты = 643 Тогда
		Результат.Сумма = Выборка.Сумма;
		Возврат Результат;
	КонецЕсли;

	Курс = РегистрыСведений.КурсыВалют.Получить(Новый Структура("Валюта", Выборка.Валюта)).Курс;
	Если Курс = 0 Тогда
		Результат.ТекстОшибки = СтрШаблон("Не найден курс валюты ""%1"".", Выборка.Валюта);
		Возврат Результат;
	КонецЕсли;

	Кратность = ?(Выборка.Кратность > 0, Выборка.Кратность, 1);
	Результат.Сумма = Окр(Выборка.Сумма * Курс / Кратность, 2);

	Возврат Результат;

КонецФункции

#КонецОбласти
