#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	ЗаполнитьСуммуНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подставляет полную сумму оплаты по договору в рублях.
&НаСервере
Процедура ЗаполнитьСуммуНаСервере()

	Расчет = Документы.Оплаты.СуммаКОплатеВРублях(Объект.Договор);
	Объект.СуммаВРублях = Расчет.Сумма;

	Если Не ПустаяСтрока(Расчет.ТекстОшибки) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Расчет.ТекстОшибки;
		Сообщение.Поле = "Объект.СуммаВРублях";
		Сообщение.Сообщить();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
