#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура ЗагрузитьДанныеИзExcel(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = "Файлы Excel|*.xlsx;*.xls";
	Диалог.Заголовок = "Выберите файл с сотрудниками";

	ВыбранныеФайлы = Ждать Диалог.ВыбратьАсинх();
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОписаниеФайла = Ждать ПоместитьФайлНаСерверАсинх(, , , Диалог.ПолноеИмяФайла);
	Если ОписаниеФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Загружено = ЗагрузитьДанныеИзExcelНаСервере(ОписаниеФайла.Адрес, Диалог.ПолноеИмяФайла);

	Элементы.Список.Обновить();
	ПоказатьОповещениеПользователя("Импорт сотрудников", , СтрШаблон("Загружено сотрудников: %1", Загружено));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Загружает сотрудников из файла Excel.
// Ожидаемые колонки (ищутся по заголовку): Должность, Имя, ФИО, Дата рождения.
// Существующий сотрудник (поиск по имени) обновляется, новый - создается.
//
// Возвращаемое значение:
//  Число - количество загруженных сотрудников.
//
&НаСервереБезКонтекста
Функция ЗагрузитьДанныеИзExcelНаСервере(АдресХранилища, ИмяФайла)

	Расширение = ?(СтрЗаканчиваетсяНа(НРег(ИмяФайла), ".xls"), "xls", "xlsx");
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
	ПолучитьИзВременногоХранилища(АдресХранилища).Записать(ИмяВременногоФайла);

	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Прочитать(ИмяВременногоФайла);
	УдалитьФайлы(ИмяВременногоФайла);

	Колонки = НайтиКолонки(ТабДок);
	Если Колонки = Неопределено Тогда
		Сообщить("В файле не найдена строка заголовков с колонками ""Имя"", ""ФИО"", ""Должность"", ""Дата рождения"".");
		Возврат 0;
	КонецЕсли;

	Загружено = 0;

	Для НомерСтроки = Колонки.СтрокаЗаголовка + 1 По ТабДок.ВысотаТаблицы Цикл

		ФИО = НормализоватьФИО(ТекстЯчейки(ТабДок, НомерСтроки, Колонки.ФИО));
		Имя = НормализоватьИмя(ТекстЯчейки(ТабДок, НомерСтроки, Колонки.Имя));

		Если ПустаяСтрока(ФИО) И ПустаяСтрока(Имя) Тогда
			Продолжить; // пустая строка
		КонецЕсли;

		Если ПустаяСтрока(ФИО) Или ПустаяСтрока(Имя) Тогда
			Сообщить(СтрШаблон("Строка %1: не заполнены Имя или ФИО, строка пропущена.", НомерСтроки));
			Продолжить;
		КонецЕсли;

		ДатаРождения = ДатаЯчейки(ТабДок, НомерСтроки, Колонки.ДатаРождения);
		Если Не ЗначениеЗаполнено(ДатаРождения) Тогда
			Сообщить(СтрШаблон("Строка %1 (%2): не удалось прочитать дату рождения.", НомерСтроки, ФИО));
		КонецЕсли;

		ТекстДолжности = ТекстЯчейки(ТабДок, НомерСтроки, Колонки.Должность);
		Должность = НайтиДолжность(ТекстДолжности);
		Если Не ЗначениеЗаполнено(Должность) И Не ПустаяСтрока(ТекстДолжности) Тогда
			Сообщить(СтрШаблон("Строка %1 (%2): неизвестная должность ""%3"".", НомерСтроки, ФИО, ТекстДолжности));
		КонецЕсли;

		Ссылка = Справочники.Сотрудники.НайтиПоНаименованию(Имя, Истина);
		Если Ссылка.Пустая() Тогда
			Сотрудник = Справочники.Сотрудники.СоздатьЭлемент();
		Иначе
			Сотрудник = Ссылка.ПолучитьОбъект();
		КонецЕсли;

		Сотрудник.Наименование = Имя;
		Сотрудник.ФИО = ФИО;
		Сотрудник.СтароеФИО = ФИО;
		Сотрудник.ДатаРождения = ДатаРождения;
		Сотрудник.СтараяДатаРождения = ДатаРождения;
		Сотрудник.Должность = Должность;

		Попытка
			Сотрудник.Записать();
			Загружено = Загружено + 1;
		Исключение
			Сообщить(СтрШаблон("Строка %1 (%2): ошибка записи: %3", НомерСтроки, ФИО,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;

	КонецЦикла;

	Возврат Загружено;

КонецФункции

// Ищет строку заголовков и номера колонок по их названиям.
&НаСервереБезКонтекста
Функция НайтиКолонки(ТабДок)

	МаксСтрокаПоиска = Мин(ТабДок.ВысотаТаблицы, 10);

	Для НомерСтроки = 1 По МаксСтрокаПоиска Цикл

		Колонки = Новый Структура("СтрокаЗаголовка, Должность, Имя, ФИО, ДатаРождения", НомерСтроки, 0, 0, 0, 0);

		Для НомерКолонки = 1 По ТабДок.ШиринаТаблицы Цикл
			Заголовок = НРег(СтрЗаменить(ТекстЯчейки(ТабДок, НомерСтроки, НомерКолонки), " ", ""));
			Если Заголовок = "должность" Тогда
				Колонки.Должность = НомерКолонки;
			ИначеЕсли Заголовок = "имя" Тогда
				Колонки.Имя = НомерКолонки;
			ИначеЕсли Заголовок = "фио" Или Заголовок = "ф.и.о." Тогда
				Колонки.ФИО = НомерКолонки;
			ИначеЕсли Заголовок = "датарождения" Тогда
				Колонки.ДатаРождения = НомерКолонки;
			КонецЕсли;
		КонецЦикла;

		Если Колонки.Имя > 0 И Колонки.ФИО > 0 Тогда
			Возврат Колонки;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаСервереБезКонтекста
Функция ТекстЯчейки(ТабДок, НомерСтроки, НомерКолонки)

	Если НомерКолонки = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(ТабДок.Область(НомерСтроки, НомерКолонки).Текст);

КонецФункции

// Части ФИО могут быть разделены разными символами (пробел, табуляция, запятая,
// точка с запятой, подчеркивание). Приводит к виду "Фамилия Имя Отчество".
&НаСервереБезКонтекста
Функция НормализоватьФИО(Знач Текст)

	Разделители = "," + ";" + "_" + Символы.Таб + Символы.НПП + Символы.ПС + Символы.ВК;
	Для Инд = 1 По СтрДлина(Разделители) Цикл
		Текст = СтрЗаменить(Текст, Сред(Разделители, Инд, 1), " ");
	КонецЦикла;

	Возврат СтрСоединить(СтрРазделить(Текст, " ", Ложь), " ");

КонецФункции

// Приводит имя к виду "Фамилия И.О.": "Зоммер Г. Я. " -> "Зоммер Г.Я.".
&НаСервереБезКонтекста
Функция НормализоватьИмя(Знач Текст)

	Возврат СтрЗаменить(НормализоватьФИО(Текст), ". ", ".");

КонецФункции

// Дата в файле бывает и текстом "01.11.1961", и значением даты Excel
// (формат "mm-dd-yy": месяц идет первым).
&НаСервереБезКонтекста
Функция ДатаЯчейки(ТабДок, НомерСтроки, НомерКолонки)

	ПустаяДата = Дата(1, 1, 1);
	Если НомерКолонки = 0 Тогда
		Возврат ПустаяДата;
	КонецЕсли;

	Область = ТабДок.Область(НомерСтроки, НомерКолонки);
	Если Область.СодержитЗначение И ТипЗнч(Область.Значение) = Тип("Дата") Тогда
		Возврат НачалоДня(Область.Значение);
	КонецЕсли;

	Текст = СокрЛП(Область.Текст);
	МесяцПервым = СтрНайти(Текст, "-") > 0 Или СтрНайти(Текст, "/") > 0;
	Текст = СтрЗаменить(СтрЗаменить(Текст, "-", "."), "/", ".");

	Части = СтрРазделить(СтрЗаменить(Текст, " ", "."), ".", Ложь);
	Если Части.Количество() < 3 Тогда
		Возврат ПустаяДата;
	КонецЕсли;

	Попытка
		Если СтрДлина(Части[0]) = 4 Тогда // ГГГГ-ММ-ДД
			Год = Число(Части[0]); Месяц = Число(Части[1]); День = Число(Части[2]);
		ИначеЕсли МесяцПервым Тогда // ММ-ДД-ГГ
			Месяц = Число(Части[0]); День = Число(Части[1]); Год = Число(Части[2]);
		Иначе // ДД.ММ.ГГГГ
			День = Число(Части[0]); Месяц = Число(Части[1]); Год = Число(Части[2]);
		КонецЕсли;
		Если Год < 100 Тогда
			Год = Год + ?(Год > 30, 1900, 2000);
		КонецЕсли;
		Возврат Дата(Год, Месяц, День);
	Исключение
		Возврат ПустаяДата;
	КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Функция НайтиДолжность(Знач Текст)

	Текст = СтрЗаменить(СокрЛП(Текст), " ", "");
	Если ПустаяСтрока(Текст) Тогда
		Возврат Перечисления.Должности.ПустаяСсылка();
	КонецЕсли;

	Для Каждого ЗначениеПеречисления Из Метаданные.Перечисления.Должности.ЗначенияПеречисления Цикл
		Если НРег(ЗначениеПеречисления.Имя) = НРег(Текст) Тогда
			Возврат Перечисления.Должности[ЗначениеПеречисления.Имя];
		КонецЕсли;
	КонецЦикла;

	Возврат Перечисления.Должности.ПустаяСсылка();

КонецФункции

#КонецОбласти
